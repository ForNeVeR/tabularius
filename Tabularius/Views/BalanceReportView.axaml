<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Tabularius.ViewModels"
             xmlns:resources="clr-namespace:Tabularius.Resources;assembly=Tabularius.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Tabularius.Views.BalanceReportView"
             x:DataType="viewModels:BalanceReportViewModel">

    <TableView ItemsSource="{Binding Entries}">
        <TableView.Columns>
            <TableViewColumn Header="{x:Static resources:Localization.BalanceReport_Account}" Binding="{Binding AccountName}" />
            <TableViewColumn Header="{x:Static resources:Localization.BalanceReport_Amount}" Binding="{Binding Amount}" />
        </TableView.Columns>
    </TableView>
</UserControl>


<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:Avalonia.Data.Converters"
                    xmlns:resources="clr-namespace:Tabularius.Resources;assembly=Tabularius.Resources"
                    xmlns:views="clr-namespace:Tabularius.Views">

    <ControlTheme x:Key="{x:Type views:JournalEmptyStatePresenter}"
                  TargetType="views:JournalEmptyStatePresenter">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsVisible="{TemplateBinding IsEmpty,
                                                  Converter={x:Static converters:BoolConverters.Not}}"/>
                    <StackPanel Name="PART_EmptyState"
                                IsVisible="{TemplateBinding IsEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <TextBlock HorizontalAlignment="Center"
                                   Text="{x:Static resources:Localization.EmptyState_NoJournalLoaded}"/>
                        <Button HorizontalAlignment="Center"
                                Command="{TemplateBinding LoadJournalCommand}"
                                Content="{x:Static resources:Localization.EmptyState_LoadJournal}"/>
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>

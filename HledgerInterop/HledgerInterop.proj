<Project Sdk="Microsoft.Build.NoTargets/3.7.0">
    <PropertyGroup>
        <!--
            Should be independent of the configuration and of the runtime identifier: the consumers reference this
            directory from other projects, including during `dotnet publish -r <rid>` invocation, where the RID would
            otherwise move the output into bin\<rid>\ and out of their sight.
        -->
        <HledgerInteropBinDir>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'bin'))))</HledgerInteropBinDir>
        <OutputPath>$(HledgerInteropBinDir)</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <ItemGroup>
        <HaskellSource Include="src/**/*.hs"/>
        <HaskellSource Include="src/**/*.hsc"/>
        <HaskellSource Include="include/**/*.h"/>
        <HaskellSource Include="test/**/*.hs"/>
        <HaskellSource Include="test/**/*.hsc"/>
        <HaskellConfig Include="*.cabal;*.def;*.yaml;*.yaml.lock"/>
        <None Include="*.license"/>
        <None Include="HledgerInterop.props"/>
    </ItemGroup>

    <PropertyGroup>
        <!-- On Linux, we'll get "unrecognized command-line option '&#45;&#45;target=x86_64-unknown-linux'" otherwise. -->
        <StackEnv Condition="$([MSBuild]::IsOSPlatform('Linux'))">CC=clang</StackEnv>
    </PropertyGroup>

    <Target Name="StackBuild" BeforeTargets="Build"
            Inputs="@(HaskellSource);@(HaskellConfig)"
            Outputs="$(OutputPath)$(SharedLibName)">

        <Exec Command="stack build"
              EnvironmentVariables="$(StackEnv)"
              IgnoreStandardErrorWarningFormat="true" />
        <Exec Command="stack path --local-install-root" ConsoleToMsBuild="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="StackInstallRoot" />
        </Exec>
        <MakeDir Directories="$(OutputPath)" />
        <Copy SourceFiles="$(StackInstallRoot.Trim())\lib\$(SharedLibName)"
              DestinationFolder="$(OutputPath)" />

        <!-- On Linux: copy GHC runtime .so dependencies alongside the shared library -->
        <Exec Condition="$([MSBuild]::IsOSPlatform('Linux'))"
              Command="ldd $(StackInstallRoot.Trim())/lib/$(SharedLibName) | grep -oP '/\S+libHS\S+\.so\S*' | xargs -I{} cp {} $(OutputPath)" />

        <Message Importance="high" Text="Haskell shared library compiled successfully."/>
    </Target>

    <!--
        Reports the native files produced by StackBuild. The wildcard is expanded when this target runs, i.e. after
        the Haskell library has been built — unlike an evaluation-time item, which is empty before compilation.
    -->
    <Target Name="GetHledgerInteropNativeFiles" DependsOnTargets="Build" Returns="@(HledgerInteropNativeFile)">
        <ItemGroup>
            <HledgerInteropNativeFile Include="$(HledgerInteropBinDir)$(SharedLibName)" />
            <!-- On Linux: the GHC runtime libraries bundled next to the shared library. -->
            <HledgerInteropNativeFile Condition="$([MSBuild]::IsOSPlatform('Linux'))"
                                      Include="$(HledgerInteropBinDir)libHS*.so" />
        </ItemGroup>
    </Target>
</Project>

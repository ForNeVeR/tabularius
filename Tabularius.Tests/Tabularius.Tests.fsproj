<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="ConfigurationTests.fs" />
        <Compile Include="ExceptionInfoTests.fs" />
        <Compile Include="ErrorCollectorTests.fs" />
        <Compile Include="ErrorListViewModelTests.fs" />
        <Compile Include="BalanceReportBuilders.fs" />
        <Compile Include="BalanceReportViewModelTests.fs" />
        <Compile Include="BackgroundActivityHostTests.fs" />
        <Compile Include="Data\AmountTests.fs" />
        <Compile Include="Interop\HledgerFixture.fs" />
        <Compile Include="Interop\GenericInteropTests.fs" />
        <Compile Include="Interop\BalanceReportTests.fs" />
        <Compile Include="StateTests.fs" />
        <Compile Include="MainViewModelTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="testdata\valid-config.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="testdata\config-with-diagnostic-mode.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

    <!-- Builds the Haskell library and copies its native output next to the test binaries. -->
    <Import Project="..\HledgerInterop\HledgerInterop.props" />

    <ItemGroup>
      <ProjectReference Include="..\Tabularius\Tabularius.fsproj" />
      <ProjectReference Include="..\Tabularius.Interop\Tabularius.Interop.csproj" />
      <ProjectReference Include="..\Tabularius.Settings\Tabularius.Settings.fsproj" />
    </ItemGroup>

</Project>
